<UserControl x:Class="Project_v1.Vista.ClientesDeudoresControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <Grid Margin="20" Background="#F4F6F8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- ZONA IZQUIERDA -->
        <Grid Grid.Column="0" Margin="0,0,18,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <Border Grid.Row="0" Background="#1F2D3A" CornerRadius="10" Padding="16">
                <StackPanel>
                    <TextBlock Text="Clientes Deudores" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Seguimiento de clientes pendientes, cobros y exportaciones."
                               FontSize="11" Foreground="#C9D4DD" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Panel de búsqueda y acciones -->
            <Border Grid.Row="2" Background="White" BorderBrush="#DFE6EC"
                    BorderThickness="1" CornerRadius="10" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Búsqueda principal -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding FiltroNombre, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8" FontSize="13">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <VisualBrush Stretch="None" AlignmentX="Left">
                                                        <VisualBrush.Visual>
                                                            <TextBlock Text="Buscar por nombre..." Foreground="Gray" Margin="8,0,0,0"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBox Grid.Column="2"
                                 Text="{Binding FiltroCedula, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8" FontSize="13">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <VisualBrush Stretch="None" AlignmentX="Left">
                                                        <VisualBrush.Visual>
                                                            <TextBlock Text="Buscar por cédula..." Foreground="Gray" Margin="8,0,0,0"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>

                    <!-- Filtros avanzados -->
                    <Expander Grid.Row="2" Header="Más filtros"
                              Foreground="#2C3E50" FontWeight="SemiBold">
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding FiltroMontoMin, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8" FontSize="13">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <VisualBrush Stretch="None" AlignmentX="Left">
                                                                <VisualBrush.Visual>
                                                                    <TextBlock Text="Monto mínimo..." Foreground="Gray" Margin="8,0,0,0"/>
                                                                </VisualBrush.Visual>
                                                            </VisualBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <TextBox Grid.Column="2"
                                         Text="{Binding FiltroMontoMax, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8" FontSize="13">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <VisualBrush Stretch="None" AlignmentX="Left">
                                                                <VisualBrush.Visual>
                                                                    <TextBlock Text="Monto máximo..." Foreground="Gray" Margin="8,0,0,0"/>
                                                                </VisualBrush.Visual>
                                                            </VisualBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Inicio" FontSize="12"
                                           Foreground="#6C7A89" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <DatePicker Grid.Column="1" SelectedDate="{Binding FiltroFechaInicioDesde}"/>
                                <DatePicker Grid.Column="3" SelectedDate="{Binding FiltroFechaInicioHasta}"/>
                                <TextBlock Grid.Column="5" Text="Vence" FontSize="12"
                                           Foreground="#6C7A89" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <DatePicker Grid.Column="6" SelectedDate="{Binding FiltroFechaVencimientoDesde}"/>
                                <DatePicker Grid.Column="8" SelectedDate="{Binding FiltroFechaVencimientoHasta}"/>
                            </Grid>
                        </Grid>
                    </Expander>

                    <!-- Acciones principales -->
                    <WrapPanel Grid.Row="4" Orientation="Horizontal">
                        <Button Content="💰 Historial Pagados"
                                Command="{Binding VerHistorialPagadosCommand}"
                                Padding="12,6" Margin="0,0,8,0"
                                Background="#1A6B3C" Foreground="White"
                                FontSize="12" BorderThickness="0"/>
                        <Button Content="✖ Limpiar"
                                Command="{Binding LimpiarFiltrosCommand}"
                                Padding="12,6" Background="#7F8C8D" Foreground="White"
                                FontSize="12" BorderThickness="0"/>
                    </WrapPanel>

                    <!-- Exportaciones -->
                    <WrapPanel Grid.Row="6" Orientation="Horizontal">
                        <Button Content="📊 Excel"
                                Command="{Binding ExportarDeudoresExcelCommand}"
                                Padding="12,6" Margin="0,0,8,0"
                                Background="#1D6A39" Foreground="White"
                                FontSize="12" BorderThickness="0"/>
                        <Button Content="📄 PDF"
                                Command="{Binding ExportarDeudoresPdfCommand}"
                                Padding="12,6" Margin="0,0,8,0"
                                Background="#2980B9" Foreground="White"
                                FontSize="12" BorderThickness="0"/>
                        <Button Content="🔔 Notificaciones"
                                Command="{Binding AbrirNotificacionesCommand}"
                                Padding="12,6" Background="#E67E22" Foreground="White"
                                FontSize="12" BorderThickness="0"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Tabla -->
            <Border Grid.Row="4" Background="White" BorderBrush="#DFE6EC"
                    BorderThickness="1" CornerRadius="10" Padding="12">
                <DataGrid ItemsSource="{Binding Clientes}"
                          SelectedItem="{Binding ClienteSeleccionado}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          CanUserResizeRows="False"
                          Background="White"
                          BorderThickness="0"
                          RowHeaderWidth="0">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#1F2D3A"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="MinHeight" Value="32"/>
                            <Setter Property="Background" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EAF4FB"/>
                                    <Setter Property="Foreground" Value="#1F2D3A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="6,4"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#ECF0F1"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"       Binding="{Binding Id}"                              Width="40"/>
                        <DataGridTextColumn Header="Nombre"   Binding="{Binding Nombre}"                          Width="160"/>
                        <DataGridTextColumn Header="Cédula"   Binding="{Binding Cedula}"                          Width="120"/>
                        <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}"                        Width="110"/>
                        <DataGridTextColumn Header="Monto"    Binding="{Binding MontoDeuda, StringFormat=C}"      Width="90"/>
                        <DataGridTextColumn Header="Vence"    Binding="{Binding FechaPago, StringFormat=dd/MM/yyyy}" Width="95"/>
                        <DataGridTemplateColumn Header="Mora" Width="65">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#EEF2F4"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TieneMora}" Value="True">
                                                        <Setter Property="Background" Value="#FDEDEC"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="No"/>
                                                    <Setter Property="Foreground" Value="#7F8C8D"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TieneMora}" Value="True">
                                                            <Setter Property="Text" Value="Sí"/>
                                                            <Setter Property="Foreground" Value="#C0392B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Barra de resumen -->
            <Border Grid.Row="6" Background="White" BorderBrush="#DFE6EC"
                    BorderThickness="1" CornerRadius="10" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Deudores activos: " FontSize="12" Foreground="#7F8C8D"/>
                        <TextBlock Text="{Binding Clientes.Count}" FontSize="12" FontWeight="Bold" Foreground="#2C3E50"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="💰 Total a cobrar: " FontSize="13" Foreground="#7F8C8D" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding TotalDeudaGeneral, StringFormat=C}"
                                   FontSize="18" FontWeight="Bold" Foreground="#E74C3C"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== PANEL DERECHO ===== -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Border Background="White" BorderBrush="#DFE6EC"
                    BorderThickness="1" CornerRadius="10" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Ficha del cliente" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock Text="Edita los datos principales y ejecuta acciones de seguimiento."
                                   FontSize="11" Foreground="#7F8C8D" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Formulario — solo admin puede editar -->
                    <Border Grid.Row="2"
                            Background="#F8FAFB"
                            BorderBrush="#E6ECF0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14"
                            IsEnabled="{Binding EsAdministrador}">
                        <Border.Resources>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="DatePicker">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Resources>
                        <StackPanel>
                            <TextBlock Text="Nombre" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8" FontSize="13" Margin="0,0,0,12"/>

                            <TextBlock Text="Cédula" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Cedula, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8" FontSize="13" Margin="0,0,0,12"/>

                            <TextBlock Text="Teléfono" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8" FontSize="13" Margin="0,0,0,12"/>

                            <TextBlock Text="Concepto" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Concepto, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8" FontSize="13" Margin="0,0,0,12"
                                     TextWrapping="Wrap" AcceptsReturn="True" Height="70"/>

                            <TextBlock Text="Monto de deuda" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding MontoDeuda, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8" FontSize="13" Margin="0,0,0,12"/>

                            <TextBlock Text="Fecha de inicio" Margin="0,0,0,5"/>
                            <DatePicker SelectedDate="{Binding FechaInicio}" Margin="0,0,0,12"/>

                            <TextBlock Text="Fecha límite de pago" Margin="0,0,0,5"/>
                            <DatePicker SelectedDate="{Binding FechaPago}"/>
                        </StackPanel>
                    </Border>

                    <!-- Guardar y Eliminar — solo admin -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="Guardar"
                                Command="{Binding GuardarCommand}"
                                Height="38" Background="#2C3E50" Foreground="White"
                                BorderThickness="0"
                                IsEnabled="{Binding EsAdministrador}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.35"/>
                                            <Setter Property="Cursor" Value="No"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="2"
                                Content="Eliminar"
                                Command="{Binding EliminarCommand}"
                                Height="38" Background="#E74C3C" Foreground="White"
                                BorderThickness="0"
                                IsEnabled="{Binding EsAdministrador}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.35"/>
                                            <Setter Property="Cursor" Value="No"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Seguimiento — disponible para todos -->
                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="✅ Pagado"
                                Command="{Binding MarcarPagadoCommand}"
                                Height="38" Background="#27AE60" Foreground="White"
                                BorderThickness="0"/>
                        <Button Grid.Column="2"
                                Content="📋 Historial"
                                Command="{Binding VerHistorialCommand}"
                                Height="38" Background="#8E44AD" Foreground="White"
                                BorderThickness="0"/>
                    </Grid>

                    <!-- Acciones secundarias — disponibles para todos -->
                    <StackPanel Grid.Row="8">
                        <Button Content="Nuevo"
                                Command="{Binding NuevoCommand}"
                                Height="36" Background="#7F8C8D" Foreground="White"
                                BorderThickness="0" Margin="0,0,0,10"/>
                        <Button Content="📄 Exportar Ficha PDF"
                                Command="{Binding ExportarFichaIndividualCommand}"
                                Height="40" Background="#2980B9" Foreground="White"
                                BorderThickness="0"/>
                    </StackPanel>

                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>