<Window x:Class="Project_v1.Vista.HistorialBackupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historial de Backups"
        Height="420" Width="860"
        MinHeight="360" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Historial de backups"
                       FontSize="18" FontWeight="Bold"
                       Foreground="#1E2937"/>
            <TextBlock Text="Muestra los últimos registros guardados en backup_log.txt."
                       FontSize="11" Foreground="#64748B"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Contenedor del DataGrid -->
        <Border Grid.Row="2"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="4">
            <DataGrid x:Name="GridHistorial"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Single"
                      Background="#F8FAFC"
                      RowBackground="#F8FAFC"
                      AlternatingRowBackground="#FFFFFF">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F1F5F9"/>
                        <Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Height" Value="38"/>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Foreground" Value="#1E2937"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EFF6FF"/>
                                <Setter Property="Foreground" Value="#1E40AF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>

                    <!-- Fecha -->
                    <DataGridTextColumn Header="Fecha"
                                        Binding="{Binding FechaTexto}"
                                        Width="150"/>

                    <!-- Estado — badge con color -->
                    <DataGridTemplateColumn Header="Estado" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="12,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#DCFCE7"/>
                                            <Setter Property="Padding" Value="10,4"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Exitoso}" Value="False">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,5,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#16A34A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Exitoso}" Value="False">
                                                            <Setter Property="Fill" Value="#DC2626"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="OK"/>
                                                    <Setter Property="Foreground" Value="#15803D"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Exitoso}" Value="False">
                                                            <Setter Property="Text" Value="Error"/>
                                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Mensaje -->
                    <DataGridTextColumn Header="Mensaje"
                                        Binding="{Binding Mensaje}"
                                        Width="220"/>

                    <!-- Ruta -->
                    <DataGridTextColumn Header="Ruta"
                                        Binding="{Binding RutaArchivo}"
                                        Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="12,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Botones inferiores -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtResumen"
               Grid.Column="0"
               VerticalAlignment="Center"
               FontSize="11"
               Foreground="#64748B"/>

            <Button Grid.Column="1"
            Content="📊 Exportar Excel"
            Click="BtnExportarExcel_Click"
            Width="130" Height="36"
            Background="#16A34A" Foreground="White"
            BorderThickness="0" FontWeight="Medium" Cursor="Hand"/>

            <Button Grid.Column="3"
            Content="📄 Exportar PDF"
            Click="BtnExportarPdf_Click"
            Width="130" Height="36"
            Background="#DC2626" Foreground="White"
            BorderThickness="0" FontWeight="Medium" Cursor="Hand"/>

            <Button Grid.Column="5"
            Content="Actualizar"
            Click="BtnActualizar_Click"
            Width="110" Height="36"
            Background="#3B82F6" Foreground="White"
            BorderThickness="0" FontWeight="Medium" Cursor="Hand"/>

            <Button Grid.Column="7"
            Content="Cerrar"
            Click="BtnCerrar_Click"
            Width="110" Height="36"
            Background="#1E2937" Foreground="White"
            BorderThickness="0" FontWeight="Medium" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>