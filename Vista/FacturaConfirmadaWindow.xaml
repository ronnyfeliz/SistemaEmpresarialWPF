<Window x:Class="Project_v1.Vista.FacturaConfirmadaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Venta Confirmada"
        Width="480" Height="660"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F6F8">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== ENCABEZADO VERDE ===== -->
        <Border Grid.Row="0" Background="#27AE60" Padding="20,18">
            <StackPanel>
                <TextBlock Text="✅ Venta Confirmada"
                           FontSize="20" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtNumFactura"
                           FontSize="13" Foreground="#D5F5E3"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- ===== INFO FACTURA ===== -->
        <Border Grid.Row="1" Background="White"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="FECHA" FontSize="10" Foreground="#7F8C8D"/>
                    <TextBlock x:Name="TxtFecha" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="CAJERO" FontSize="10" Foreground="#7F8C8D"/>
                    <TextBlock x:Name="TxtCajero" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== CONTENIDO SCROLLABLE ===== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ── TABLA PRODUCTOS ── -->
                <Border Background="White" Margin="0,8,0,0"
                        BorderBrush="#E0E0E0" BorderThickness="0,1,0,1">
                    <StackPanel>
                        <!-- Label -->
                        <Border Background="#2C3E50" Padding="16,7">
                            <TextBlock Text="🛒  Productos"
                                       Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>

                        <!-- Header -->
                        <Grid Background="#3D5166">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="85"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Producto"
                                       Foreground="White" FontSize="11" FontWeight="Bold" Padding="16,8"/>
                            <TextBlock Grid.Column="1" Text="Cant."
                                       Foreground="White" FontSize="11" FontWeight="Bold" Padding="4,8" TextAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Precio"
                                       Foreground="White" FontSize="11" FontWeight="Bold" Padding="4,8" TextAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="Subtotal"
                                       Foreground="White" FontSize="11" FontWeight="Bold" Padding="4,8,16,8" TextAlignment="Right"/>
                        </Grid>

                        <!-- Filas productos -->
                        <ListView x:Name="ListaProductos"
                                  BorderThickness="0" Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="85"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Producto.Nombre}"
                                                   FontSize="12" Padding="16,7" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Cantidad}"
                                                   FontSize="12" Padding="4,7" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding PrecioUnitario, StringFormat=C}"
                                                   FontSize="12" Padding="4,7" TextAlignment="Right" Foreground="#555"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Subtotal, StringFormat=C}"
                                                   FontSize="12" Padding="4,7,16,7" TextAlignment="Right" FontWeight="SemiBold"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- ── TABLA SERVICIOS (se oculta si no hay) ── -->
                <Border x:Name="SeccionServicios"
                        Background="White" Margin="0,8,0,0"
                        BorderBrush="#E0E0E0" BorderThickness="0,1,0,1">
                    <StackPanel>
                        <!-- Label -->
                        <Border Background="#1A5276" Padding="16,7">
                            <TextBlock Text="🛠  Servicios"
                                       Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>

                        <!-- Header -->
                        <Grid Background="#1F618D">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="85"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Servicio"
                                       Foreground="White" FontSize="11" FontWeight="Bold" Padding="16,8"/>
                            <TextBlock Grid.Column="1" Text="Cant."
                                       Foreground="White" FontSize="11" FontWeight="Bold" Padding="4,8" TextAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Precio"
                                       Foreground="White" FontSize="11" FontWeight="Bold" Padding="4,8" TextAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="Subtotal"
                                       Foreground="White" FontSize="11" FontWeight="Bold" Padding="4,8,16,8" TextAlignment="Right"/>
                        </Grid>

                        <!-- Filas servicios -->
                        <ListView x:Name="ListaServicios"
                                  BorderThickness="0" Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="85"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Servicio.Nombre}"
                                                   FontSize="12" Padding="16,7" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Cantidad}"
                                                   FontSize="12" Padding="4,7" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding PrecioUnitario, StringFormat=C}"
                                                   FontSize="12" Padding="4,7" TextAlignment="Right" Foreground="#555"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Subtotal, StringFormat=C}"
                                                   FontSize="12" Padding="4,7,16,7" TextAlignment="Right" FontWeight="SemiBold"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ===== TOTAL ===== -->
        <Border Grid.Row="3" Background="White"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,1"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="TOTAL"
                           FontSize="14" FontWeight="Bold"
                           Foreground="#2C3E50" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="TxtTotal"
                           FontSize="22" FontWeight="Bold"
                           Foreground="#27AE60" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ===== BOTONES ===== -->
        <Grid Grid.Row="4" Margin="16,12,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="BtnCerrar"
                    Content="Cerrar"
                    Height="40" FontSize="13"
                    Background="#7F8C8D" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="BtnCerrar_Click"/>

            <Button Grid.Column="2" x:Name="BtnExportarPdf"
                    Content="📄 Exportar PDF"
                    Height="40" FontSize="13"
                    Background="#2C3E50" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="BtnExportarPdf_Click"/>
        </Grid>
    </Grid>
</Window>