<Window x:Class="Project_v1.Vista.ReporteDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generar Reporte"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F6FA">

    <StackPanel Margin="24,20">

        <!-- Título dinámico -->
        <TextBlock x:Name="TxtTitulo"
                   FontSize="15" FontWeight="Bold"
                   Foreground="#2C3E50" Margin="0,0,0,16"/>

        <!-- SELECTOR AÑO (siempre visible) -->
        <TextBlock Text="Año:" Foreground="Gray" FontSize="12" Margin="0,0,0,4"/>
        <ComboBox x:Name="CmbAnio" Height="32" Margin="0,0,0,12"
                  SelectionChanged="CmbAnio_SelectionChanged"/>

        <!-- SELECTOR MES (visible para Mes y Día) -->
        <StackPanel x:Name="PanelMes">
            <TextBlock Text="Mes:" Foreground="Gray" FontSize="12" Margin="0,0,0,4"/>
            <ComboBox x:Name="CmbMes" Height="32" Margin="0,0,0,12"
                      SelectionChanged="CmbMes_SelectionChanged">
                <ComboBoxItem Content="Enero"      Tag="1"/>
                <ComboBoxItem Content="Febrero"    Tag="2"/>
                <ComboBoxItem Content="Marzo"      Tag="3"/>
                <ComboBoxItem Content="Abril"      Tag="4"/>
                <ComboBoxItem Content="Mayo"       Tag="5"/>
                <ComboBoxItem Content="Junio"      Tag="6"/>
                <ComboBoxItem Content="Julio"      Tag="7"/>
                <ComboBoxItem Content="Agosto"     Tag="8"/>
                <ComboBoxItem Content="Septiembre" Tag="9"/>
                <ComboBoxItem Content="Octubre"    Tag="10"/>
                <ComboBoxItem Content="Noviembre"  Tag="11"/>
                <ComboBoxItem Content="Diciembre"  Tag="12"/>
            </ComboBox>
        </StackPanel>

        <!-- SELECTOR DÍA (visible solo para Día) -->
        <StackPanel x:Name="PanelDia">
            <TextBlock Text="Día:" Foreground="Gray" FontSize="12" Margin="0,0,0,4"/>
            <ComboBox x:Name="CmbDia" Height="32" Margin="0,0,0,12"/>
        </StackPanel>

        <!-- Selector de formato -->
        <TextBlock Text="Formato:" Foreground="Gray" FontSize="12" Margin="0,0,0,6"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <RadioButton x:Name="RbExcel" Content="📗  Excel"
                         GroupName="Formato" IsChecked="True"
                         Margin="0,0,20,0" FontSize="13"/>
            <RadioButton x:Name="RbPdf"   Content="📕  PDF"
                         GroupName="Formato" FontSize="13"/>
        </StackPanel>

        <!-- Botones -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Cancelar"
                    Height="34" Background="#95A5A6" Foreground="White"
                    Click="BtnCancelar_Click"/>
            <Button Grid.Column="2" Content="✔  Generar"
                    Height="34" Background="#1A6B3A" Foreground="White"
                    FontWeight="Bold"
                    Click="BtnGenerar_Click"/>
        </Grid>

    </StackPanel>
</Window>
