<UserControl x:Class="Project_v1.Vista.ProveedoresControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F4F6F8">
        <ScrollViewer.Resources>
            <Style x:Key="PlaceholderTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="White"/>
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Background">
                            <Setter.Value>
                                <VisualBrush Stretch="None" AlignmentX="Left">
                                    <VisualBrush.Visual>
                                        <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=TextBox}, Path=Tag}"
                                                   Foreground="#8A97A4" Margin="9,0,0,0"/>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ScrollViewer.Resources>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ ENCABEZADO ═══ -->
            <Grid Grid.Row="0" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Gestión de Proveedores"
                               FontSize="22" FontWeight="Bold" Foreground="#263645"/>
                    <TextBlock Text="Suministros, saldos, pagos e historial financiero por proveedor."
                               FontSize="12" Foreground="#6F7F8F" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="🔔 Notificaciones"
                        Command="{Binding VerNotificacionesProveedorCommand}"
                        Height="34" Padding="14,0" Margin="0,0,8,0"
                        Background="#8A4B08" Foreground="White"/>
                <Button Grid.Column="2" Content="Historial"
                        Command="{Binding VerHistorialTransaccionesCommand}"
                        Height="34" Padding="14,0" Margin="0,0,8,0"
                        Background="#1A5276" Foreground="White"/>
                <Button Grid.Column="3" Content="Exportar Excel"
                        Command="{Binding ExportarListaExcelCommand}"
                        Height="34" Padding="14,0" Margin="0,0,8,0"
                        Background="#1E8449" Foreground="White"/>
                <Button Grid.Column="4" Content="Exportar PDF"
                        Command="{Binding ExportarListaPdfCommand}"
                        Height="34" Padding="14,0"
                        Background="#C0392B" Foreground="White"/>
            </Grid>

            <!-- ═══ TARJETAS RESUMEN ═══ -->
            <UniformGrid Grid.Row="2" Grid.ColumnSpan="3" Columns="3">
                <Border Background="White" BorderBrush="#DDE5EC" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Proveedores adeudados" FontSize="11" Foreground="#7D6608"/>
                        <TextBlock Text="{Binding ProveedoresAdeudados}" FontSize="24" FontWeight="Bold" Foreground="#B9770E"/>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#DDE5EC" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Proveedores pagados" FontSize="11" Foreground="#1E8449"/>
                        <TextBlock Text="{Binding ProveedoresPagados}" FontSize="24" FontWeight="Bold" Foreground="#239B56"/>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#DDE5EC" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Dinero adeudado" FontSize="11" Foreground="#7B241C"/>
                        <TextBlock Text="{Binding DeudaTotalProveedores, StringFormat=C}" FontSize="24" FontWeight="Bold" Foreground="#C0392B"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ═══ LISTA DE PROVEEDORES ═══ -->
            <Border Grid.Row="4" Grid.Column="0"
                    Background="White" BorderBrush="#DDE5EC"
                    BorderThickness="1" CornerRadius="8" Padding="14"
                    Height="340">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Fila 1: TextBoxes -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding FiltroNombre, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0" Padding="6">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <VisualBrush Stretch="None" AlignmentX="Left">
                                                        <VisualBrush.Visual>
                                                            <TextBlock Text="Proveedor..." Foreground="Gray" Margin="8,0,0,0"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBox Grid.Column="1"
                                 Text="{Binding FiltroRnc, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0" Padding="6">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <VisualBrush Stretch="None" AlignmentX="Left">
                                                        <VisualBrush.Visual>
                                                            <TextBlock Text="RNC..." Foreground="Gray" Margin="8,0,0,0"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBox Grid.Column="2"
                                 Text="{Binding FiltroCantidadMercancia, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0" Padding="6">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <VisualBrush Stretch="None" AlignmentX="Left">
                                                        <VisualBrush.Visual>
                                                            <TextBlock Text="Cant. mín..." Foreground="Gray" Margin="8,0,0,0"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBox Grid.Column="3"
                                 Text="{Binding FiltroMontoMinimo, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0" Padding="6">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <VisualBrush Stretch="None" AlignmentX="Left">
                                                        <VisualBrush.Visual>
                                                            <TextBlock Text="Deuda mín..." Foreground="Gray" Margin="8,0,0,0"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBox Grid.Column="4"
                                 Text="{Binding FiltroMontoMaximo, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="6">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <VisualBrush Stretch="None" AlignmentX="Left">
                                                        <VisualBrush.Visual>
                                                            <TextBlock Text="Deuda máx..." Foreground="Gray" Margin="8,0,0,0"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>

                    <!-- Fila 2: ComboBox + Limpiar -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  SelectedValue="{Binding FiltroEstado, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Content"
                                  Padding="6" Margin="0,0,8,0">
                            <ComboBoxItem Content="Todos"/>
                            <ComboBoxItem Content="Pagado"/>
                            <ComboBoxItem Content="Con deuda"/>
                        </ComboBox>
                        <ComboBox Grid.Column="1"
                                  SelectedValue="{Binding FiltroTipo, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Content"
                                  Padding="6" Margin="0,0,8,0">
                            <ComboBoxItem Content="Todos"/>
                            <ComboBoxItem Content="Productos"/>
                            <ComboBoxItem Content="Servicios"/>
                            <ComboBoxItem Content="Productos y Servicios"/>
                        </ComboBox>
                        <Button Grid.Column="2" Content="✖ Limpiar"
                                Command="{Binding LimpiarFiltrosCommand}"
                                Height="32" Padding="12,0"
                                Background="#7F8C8D" Foreground="White" FontSize="12"/>
                    </Grid>

                    <!-- Fila 3: Checkbox -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <CheckBox Content="Mostrar proveedores inactivos"
                                  IsChecked="{Binding MostrarInactivos}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Fila 4: Tabla -->
                    <DataGrid Grid.Row="6"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True"
                              ItemsSource="{Binding Proveedores}"
                              SelectedItem="{Binding ProveedorSeleccionado}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              CanUserResizeRows="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#263645"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="10,8"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding TipoTexto}" Width="145"/>
                            <DataGridTextColumn Header="RNC" Binding="{Binding RncOCedula}" Width="105"/>
                            <DataGridTextColumn Header="Deuda" Binding="{Binding DeudaTotal, StringFormat=C}" Width="105"/>
                            <DataGridTemplateColumn Header="Estado" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#EAF7EF"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EstadoTexto}" Value="CON DEUDA">
                                                            <Setter Property="Background" Value="#FDEDEC"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding EstadoTexto}" FontSize="10" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#1E8449"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EstadoTexto}" Value="CON DEUDA">
                                                                <Setter Property="Foreground" Value="#C0392B"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Activo" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Center" FontSize="12" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Sí"/>
                                                    <Setter Property="Foreground" Value="#1E8449"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Activo}" Value="False">
                                                            <Setter Property="Text" Value="No"/>
                                                            <Setter Property="Foreground" Value="#C0392B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ═══ FORMULARIO PROVEEDOR ═══ -->
            <Border Grid.Row="4" Grid.Column="2"
                    Background="White" BorderBrush="#DDE5EC"
                    BorderThickness="1" CornerRadius="8" Padding="14"
                    Height="340">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Datos del proveedor"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="#263645" Margin="0,0,0,12"/>
                        <TextBlock Text="Nombre"/>
                        <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8" Margin="0,4,0,10" IsEnabled="{Binding EsAdmin}"/>
                        <TextBlock Text="Tipo de proveedor"/>
                        <ComboBox SelectedValue="{Binding TipoProveedor, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Content"
                                  Padding="6" Margin="0,4,0,10" IsEnabled="{Binding EsAdmin}">
                            <ComboBoxItem Content="Productos"/>
                            <ComboBoxItem Content="Servicios"/>
                            <ComboBoxItem Content="Productos y Servicios"/>
                        </ComboBox>
                        <TextBlock Text="RNC o cédula"/>
                        <TextBox Text="{Binding RncOCedula, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8" Margin="0,4,0,10" IsEnabled="{Binding EsAdmin}"/>
                        <TextBlock Text="Teléfono"/>
                        <TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8" Margin="0,4,0,10" IsEnabled="{Binding EsAdmin}"/>
                        <TextBlock Text="Correo"/>
                        <TextBox Text="{Binding Correo, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8" Margin="0,4,0,10" IsEnabled="{Binding EsAdmin}"/>
                        <TextBlock Text="Dirección"/>
                        <TextBox Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8" Height="58" TextWrapping="Wrap" AcceptsReturn="True"
                                 Margin="0,4,0,10" IsEnabled="{Binding EsAdmin}"/>
                        <CheckBox Content="Proveedor activo"
                                  IsChecked="{Binding Activo}"
                                  Margin="0,0,0,12" IsEnabled="{Binding EsAdmin}"/>

                        <!-- Mini tarjetas Deuda / Estado -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#EEF6FB" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Deuda" FontSize="11" Foreground="#6F7F8F"/>
                                    <TextBlock Text="{Binding DeudaProveedorSeleccionado, StringFormat=C}"
                                               FontSize="17" FontWeight="Bold" Foreground="#C0392B"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#F3F6F8" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Estado" FontSize="11" Foreground="#6F7F8F"/>
                                    <TextBlock Text="{Binding EstadoProveedorSeleccionado}"
                                               FontSize="17" FontWeight="Bold" Foreground="#263645"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Guardar -->
                        <Button Content="Guardar" Command="{Binding GuardarCommand}"
                                Height="36" Background="#263645" Foreground="White"
                                Margin="0,0,0,8" IsEnabled="{Binding EsAdmin}"/>

                        <!-- Activar + Desactivar -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Activar"
                                    Command="{Binding ActivarCommand}"
                                    Height="36" Foreground="White"
                                    IsEnabled="{Binding EsAdmin}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#4A4A4A"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProveedorSeleccionado.Activo}" Value="False">
                                                <Setter Property="Background" Value="#1E8449"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="2" Content="Desactivar"
                                    Command="{Binding EliminarCommand}"
                                    Height="36" Background="#C0392B" Foreground="White"
                                    IsEnabled="{Binding EsAdmin}"/>
                        </Grid>

                        <!-- Nuevo -->
                        <Button Content="Nuevo" Command="{Binding NuevoCommand}"
                                Height="36" Background="#7F8C8D" Foreground="White"/>

                        <!-- Aviso cajero -->
                        <Border Background="#FEF9E7" BorderBrush="#F5B041"
                                BorderThickness="1" CornerRadius="6"
                                Padding="10" Margin="0,12,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EsAdmin}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="El cajero puede ver historial, exportar y registrar pagos. Solo el administrador crea, modifica o elimina proveedores."
                                       TextWrapping="Wrap" FontSize="11" Foreground="#9A6A10"/>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ═══ TRANSACCIONES + PANEL DERECHO ═══ -->
            <Grid Grid.Row="6" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="White" BorderBrush="#DDE5EC"
                        BorderThickness="1" CornerRadius="8" Padding="14"
                        Height="320">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Barra superior con Popup dropdowns -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
               Text="Transacciones del proveedor seleccionado"
               FontSize="13" FontWeight="Bold" Foreground="#263645"
               VerticalAlignment="Center"/>

                            <!-- Dropdown Exportar Transacciones -->
                            <Grid Grid.Column="1">
                                <Button x:Name="BtnExportarHistorial"
                Height="26" Padding="8,0" FontSize="11"
                Background="#1E8449" Foreground="White"
                Click="BtnExportarHistorial_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Transacciones" VerticalAlignment="Center"/>
                                        <TextBlock Text=" ▾" VerticalAlignment="Center" FontSize="9"/>
                                    </StackPanel>
                                </Button>
                                <Popup x:Name="PopupHistorial"
               PlacementTarget="{Binding ElementName=BtnExportarHistorial}"
               Placement="Bottom" StaysOpen="False">
                                    <Border Background="White" BorderBrush="#DDE5EC"
                    BorderThickness="1" CornerRadius="4">
                                        <StackPanel>
                                            <Button Content="📊 Excel"
                            Click="ExportarHistorialExcel_Click"
                            Padding="14,8" Background="White"
                            Foreground="#1E8449" BorderThickness="0"
                            HorizontalContentAlignment="Left"/>
                                            <Button Content="📄 PDF"
                            Click="ExportarHistorialPdf_Click"
                            Padding="14,8" Background="White"
                            Foreground="#C0392B" BorderThickness="0"
                            HorizontalContentAlignment="Left"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>

                            <!-- Dropdown Exportar Movimientos -->
                            <Grid Grid.Column="3">
                                <Button x:Name="BtnExportarMovimientos"
                Height="26" Padding="8,0" FontSize="11"
                Background="#117A65" Foreground="White"
                Click="BtnExportarMovimientos_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Movimientos" VerticalAlignment="Center"/>
                                        <TextBlock Text=" ▾" VerticalAlignment="Center" FontSize="9"/>
                                    </StackPanel>
                                </Button>
                                <Popup x:Name="PopupMovimientos"
               PlacementTarget="{Binding ElementName=BtnExportarMovimientos}"
               Placement="Bottom" StaysOpen="False">
                                    <Border Background="White" BorderBrush="#DDE5EC"
                    BorderThickness="1" CornerRadius="4">
                                        <StackPanel>
                                            <Button Content="📊 Excel"
                            Click="ExportarMovimientoExcel_Click"
                            Padding="14,8" Background="White"
                            Foreground="#1E8449" BorderThickness="0"
                            HorizontalContentAlignment="Left"/>
                                            <Button Content="📄 PDF"
                            Click="ExportarMovimientoPdf_Click"
                            Padding="14,8" Background="White"
                            Foreground="#C0392B" BorderThickness="0"
                            HorizontalContentAlignment="Left"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>

                            <!-- Ver Detalles -->
                            <Button Grid.Column="5"
            Content="🔍 Detalles"
            Command="{Binding VerDetallesCommand}"
            Height="26" Padding="8,0" FontSize="11"
            IsEnabled="{Binding HaySeleccionDetalle}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#BDC3C7"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="True">
                                                <Setter Property="Background" Value="#D4AC0D"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- TabControl con deselección -->
                        <TabControl Grid.Row="2">
                            <TabItem Header="Transacciones">
                                <DataGrid ItemsSource="{Binding Transacciones}"
          SelectedItem="{Binding TransaccionSeleccionada}"
          AutoGenerateColumns="False" IsReadOnly="True"
          CanUserAddRows="False" RowHeaderWidth="0"
          PreviewMouseLeftButtonDown="GridTransacciones_PreviewMouseLeftButtonDown"
          SelectionChanged="GridTransacciones_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID Trans." Binding="{Binding Id}" Width="80"/>
                                        <DataGridTextColumn Header="ID Prov." Binding="{Binding ProveedorId}" Width="75"/>
                                        <DataGridTextColumn Header="Fecha" Binding="{Binding FechaProvision, StringFormat=dd/MM/yyyy}" Width="95"/>
                                        <DataGridTextColumn Header="Cantidad" Binding="{Binding CantidadMercancia}" Width="80"/>
                                        <DataGridTextColumn Header="Total" Binding="{Binding MontoTotal, StringFormat=C}" Width="100"/>
                                        <DataGridTextColumn Header="Pagado" Binding="{Binding MontoPagado, StringFormat=C}" Width="100"/>
                                        <DataGridTextColumn Header="Pendiente" Binding="{Binding SaldoPendiente, StringFormat=C}" Width="110"/>
                                        <DataGridTextColumn Header="Estado" Binding="{Binding EstadoPago}" Width="110"/>
                                        <DataGridTextColumn Header="Límite" Binding="{Binding FechaLimitePago, StringFormat=dd/MM/yyyy}" Width="95"/>
                                        <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Movimientos">
                                <DataGrid ItemsSource="{Binding Historial}"
          SelectedItem="{Binding MovimientoSeleccionado}"
          AutoGenerateColumns="False" IsReadOnly="True"
          CanUserAddRows="False" RowHeaderWidth="0"
          PreviewMouseLeftButtonDown="GridMovimientos_PreviewMouseLeftButtonDown"
          SelectionChanged="GridMovimientos_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="130"/>
                                        <DataGridTextColumn Header="Tipo" Binding="{Binding TipoMovimiento}" Width="120"/>
                                        <DataGridTextColumn Header="ID Trans." Binding="{Binding TransaccionProveedorId}" Width="80"/>
                                        <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>
                                        <DataGridTextColumn Header="Monto" Binding="{Binding Monto, StringFormat=C}" Width="110"/>
                                        <DataGridTextColumn Header="Saldo" Binding="{Binding SaldoResultante, StringFormat=C}" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Background="White" BorderBrush="#DDE5EC"
                        BorderThickness="1" CornerRadius="8" Padding="14"
                        Height="320">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Expander Header="Nueva transacción" IsExpanded="False" Margin="0,0,0,10">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="Fecha"/>
                                    <DatePicker SelectedDate="{Binding FechaProvision}"
                                                Margin="0,4,0,8" IsEnabled="{Binding EsAdmin}"/>
                                    <TextBlock Text="Cantidad total"/>
                                    <TextBox Text="{Binding CantidadMercancia, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="8" Margin="0,4,0,8"
                                             Tag="Cantidad total de mercancía"
                                             Style="{StaticResource PlaceholderTextBoxStyle}"
                                             IsEnabled="{Binding EsAdmin}"/>
                                    <TextBlock Text="Monto total"/>
                                    <TextBox Text="{Binding MontoTotal, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="8" Margin="0,4,0,8"
                                             Tag="Monto total de la operación"
                                             Style="{StaticResource PlaceholderTextBoxStyle}"
                                             IsEnabled="{Binding EsAdmin}"/>
                                    <TextBlock Text="Monto abonado"/>
                                    <TextBox Text="{Binding MontoAbonado, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="8" Margin="0,4,0,8"
                                             Tag="Monto abonado inicial"
                                             Style="{StaticResource PlaceholderTextBoxStyle}"
                                             IsEnabled="{Binding EsAdmin}"/>
                                    <TextBlock Text="Fecha límite"/>
                                    <DatePicker SelectedDate="{Binding FechaLimitePago}"
                                                Margin="0,4,0,8" IsEnabled="{Binding EsAdmin}"/>
                                    <TextBlock Text="Descripción"/>
                                    <TextBox Text="{Binding DescripcionTransaccion, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="8" Height="48" TextWrapping="Wrap" AcceptsReturn="True"
                                             Margin="0,4,0,10"
                                             Tag="Detalle del suministro"
                                             Style="{StaticResource PlaceholderTextBoxStyle}"
                                             IsEnabled="{Binding EsAdmin}"/>
                                    <Button Content="Agregar transacción"
                                            Command="{Binding AgregarTransaccionCommand}"
                                            Height="36" Background="#1E8449" Foreground="White"
                                            IsEnabled="{Binding EsAdmin}"/>
                                </StackPanel>
                            </Expander>
                            <Expander Header="Pago a transacción" IsExpanded="False">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="Monto a pagar"/>
                                    <TextBox Text="{Binding MontoPago, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="8" Margin="0,4,0,8"
                                             Tag="Ingrese el monto a pagar"
                                             Style="{StaticResource PlaceholderTextBoxStyle}"/>
                                    <TextBlock Text="Observación"/>
                                    <TextBox Text="{Binding ObservacionPago, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="8" Height="44" TextWrapping="Wrap" AcceptsReturn="True"
                                             Margin="0,4,0,10"
                                             Tag="Observación del pago"
                                             Style="{StaticResource PlaceholderTextBoxStyle}"/>
                                    <Button Content="Pagar" Command="{Binding PagarCommand}"
                                            Height="36" Background="#D68910" Foreground="White"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
