<UserControl x:Class="Project_v1.Vista.InventarioWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= FILTROS ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,15">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Inventario de Productos"
                       FontSize="20" FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Nombre -->
                <TextBox Grid.Column="0"
                         Text="{Binding FiltroNombre, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,8,0" Padding="6">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush Stretch="None" AlignmentX="Left">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="Nombre..." Foreground="Gray" Margin="8,0,0,0"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Marca -->
                <TextBox Grid.Column="1"
                         Text="{Binding FiltroMarca, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,8,0" Padding="6">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush Stretch="None" AlignmentX="Left">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="Marca..." Foreground="Gray" Margin="8,0,0,0"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Categoria -->
                <TextBox Grid.Column="2"
                         Text="{Binding FiltroCategoria, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,8,0" Padding="6">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush Stretch="None" AlignmentX="Left">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="Categoría..." Foreground="Gray" Margin="8,0,0,0"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Precio Min -->
                <TextBox Grid.Column="3"
                         Text="{Binding FiltroPrecioMin, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,8,0" Padding="6">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush Stretch="None" AlignmentX="Left">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="Precio min..." Foreground="Gray" Margin="8,0,0,0"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Precio Max -->
                <TextBox Grid.Column="4"
                         Text="{Binding FiltroPrecioMax, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,8,0" Padding="6">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush Stretch="None" AlignmentX="Left">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="Precio max..." Foreground="Gray" Margin="8,0,0,0"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Stock Min -->
                <TextBox Grid.Column="5"
                         Text="{Binding FiltroStockMin, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,8,0" Padding="6">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush Stretch="None" AlignmentX="Left">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="Stock mín..." Foreground="Gray" Margin="8,0,0,0"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Botón Stock -->
                <Grid Grid.Column="6" Margin="0,0,8,0">
                    <Button Content="🔔 Stock"
                            Command="{Binding VerStockBajoCommand}"
                            Padding="8,0" Height="32"
                            Background="#E67E22" Foreground="White" FontSize="12"/>
                    <Border Background="#E74C3C" CornerRadius="8"
                            MinWidth="18" Height="18"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,-6,-6,0"
                            Visibility="{Binding HayStockBajo, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding CantidadStockBajo}"
                                   Foreground="White" FontSize="10" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="3,1"/>
                    </Border>
                </Grid>

                <!-- Exportar Excel -->
                <Button Grid.Column="7"
                        Content="📊 Exportar Excel"
                        Command="{Binding ExportarExcelCommand}"
                        Padding="10,0" Height="32"
                        Background="#1D6A39" Foreground="White"
                        FontSize="12" Margin="0,0,8,0"/>

                <!-- Limpiar -->
                <Button Grid.Column="8"
                        Content="✖ Limpiar"
                        Command="{Binding LimpiarFiltrosCommand}"
                        Padding="8,0" Height="32"
                        Background="#7F8C8D" Foreground="White" FontSize="12"/>

            </Grid>

        </Grid>
        <!-- ↑ CIERRE del Grid de filtros (Grid.Row="0") -->

        <!-- ================= TABLA + FORMULARIO ================= -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- ================= TABLA ================= -->
            <DataGrid Grid.Column="0"
                      Margin="0,0,20,0"
                      ItemsSource="{Binding Productos}"
                      SelectedItem="{Binding ProductoSeleccionado}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      CanUserResizeRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"          Binding="{Binding Id}"                     Width="45"/>
                    <DataGridTextColumn Header="Nombre"      Binding="{Binding Nombre}"                 Width="*"/>
                    <DataGridTextColumn Header="Marca"       Binding="{Binding Marca}"                  Width="100"/>
                    <DataGridTextColumn Header="Categoria"   Binding="{Binding Categoria}"              Width="100"/>
                    <DataGridTextColumn Header="Precio"      Binding="{Binding Precio, StringFormat=C}" Width="80"/>
                    <DataGridTextColumn Header="Stock"       Binding="{Binding Stock}"                  Width="60"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ================= FORMULARIO ================= -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid IsEnabled="{Binding EsAdministrador}">
                    <Grid.Resources>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Resources>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Datos del Producto"
                               FontSize="16" FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <TextBlock Grid.Row="1"  Text="Nombre"       Margin="0,0,0,5"/>
                    <TextBox   Grid.Row="2"
                               Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                               Padding="8" FontSize="13" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="3"  Text="Marca"        Margin="0,0,0,5"/>
                    <TextBox   Grid.Row="4"
                               Text="{Binding Marca, UpdateSourceTrigger=PropertyChanged}"
                               Padding="8" FontSize="13" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="5"  Text="Categoria"    Margin="0,0,0,5"/>
                    <TextBox   Grid.Row="6"
                               Text="{Binding Categoria, UpdateSourceTrigger=PropertyChanged}"
                               Padding="8" FontSize="13" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="7"  Text="Descripcion"  Margin="0,0,0,5"/>
                    <TextBox   Grid.Row="8"
                               Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}"
                               Padding="8" FontSize="13" Margin="0,0,0,10"
                               Height="70" TextWrapping="Wrap" AcceptsReturn="True"/>

                    <TextBlock Grid.Row="9"  Text="Precio"       Margin="0,0,0,5"/>
                    <TextBox   Grid.Row="10"
                               Text="{Binding Precio, UpdateSourceTrigger=PropertyChanged}"
                               Padding="8" FontSize="13" Margin="0,0,0,10"/>

                    <TextBlock Grid.Row="11" Text="Stock"        Margin="0,0,0,5"/>
                    <TextBox   Grid.Row="12"
                               Text="{Binding Stock, UpdateSourceTrigger=PropertyChanged}"
                               Padding="8" FontSize="13" Margin="0,0,0,20"/>

                    <Button Grid.Row="13"
                            Content="Guardar"
                            Command="{Binding GuardarCommand}"
                            Padding="10" FontSize="13" Height="38"
                            Background="#27AE60" Foreground="White"
                            Margin="0,0,0,8"/>

                    <Button Grid.Row="14"
                            Content="Eliminar"
                            Command="{Binding EliminarCommand}"
                            Padding="10" FontSize="13" Height="38"
                            Background="#E74C3C" Foreground="White"
                            Margin="0,0,0,8"/>

                    <Button Grid.Row="15"
                            Content="Nuevo Producto"
                            Command="{Binding NuevoCommand}"
                            Padding="10" FontSize="13" Height="38"
                            Background="#2C3E50" Foreground="White"/>

                </Grid>
            </ScrollViewer>

        </Grid>
        <!-- ↑ CIERRE del Grid tabla+formulario (Grid.Row="1") -->

    </Grid>
    <!-- ↑ CIERRE del Grid principal -->

</UserControl>
