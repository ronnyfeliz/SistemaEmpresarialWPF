<Window x:Class="Project_v1.Vista.ProveedorVencimientoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vencimientos de proveedores"
        Height="420"
        Width="820"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Pagos a proveedores por vencer o vencidos"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#8A4B08"/>
            <TextBlock Text="Revisa las transacciones con saldo pendiente y fecha límite cercana."
                       FontSize="12"
                       Foreground="#6F7F8F"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <DataGrid Grid.Row="2"
          ItemsSource="{Binding Transacciones}"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          CanUserAddRows="False"
          RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID Trans."    Binding="{Binding IdTransaccion}"                         Width="75"/>
                <DataGridTextColumn Header="Proveedor"    Binding="{Binding NombreProveedor}"                       Width="*"/>
                <DataGridTextColumn Header="Fecha límite" Binding="{Binding FechaLimite, StringFormat=dd/MM/yyyy}"  Width="110"/>
                <DataGridTextColumn Header="Total"        Binding="{Binding MontoTotal,   StringFormat=C}"          Width="105"/>
                <DataGridTextColumn Header="Pendiente"    Binding="{Binding SaldoPendiente, StringFormat=C}"        Width="110"/>

                <!-- Columna Alerta con color dinámico -->
                <DataGridTemplateColumn Header="Alerta" Width="175">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4"
                            Padding="6,3"
                            HorizontalAlignment="Left"
                            Background="{Binding ColorAlerta}">
                                <TextBlock Text="{Binding EstadoAlerta}"
                                   Foreground="White"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Exportar a Excel"
                    Click="ExportarExcel_Click"
                    Height="34"
                    Padding="16,0"
                    Margin="0,0,8,0"
                    Background="#1E8449"
                    Foreground="White"/>

            <Button Content="Entendido"
                    Click="Entendido_Click"
                    Height="34"
                    Padding="18,0"
                    Background="#263645"
                    Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
