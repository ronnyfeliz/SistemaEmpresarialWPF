<Window x:Class="Project_v1.Vista.NotificacionesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚠️ Notificaciones de Deudas Pendientes"
        Height="480" Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0"
                   Text="Alertas de Deudas Pendientes"
                   FontSize="18" FontWeight="Bold"
                   Margin="0,0,0,5"/>

        <!-- Subtítulo -->
        <TextBlock Grid.Row="1"
                   Text="Los siguientes clientes requieren atención hoy:"
                   FontSize="13" Foreground="Gray"
                   Margin="0,0,0,15"/>

        <!-- Tabla de notificaciones -->
        <DataGrid Grid.Row="2"
                  x:Name="GridNotificaciones"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserResizeRows="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Cliente" Binding="{Binding NombreCliente}" Width="*"/>
                <DataGridTextColumn Header="Cédula" Binding="{Binding Cedula}" Width="110"/>
                <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono}" Width="100"/>
                <DataGridTextColumn Header="Monto" Binding="{Binding Monto, StringFormat=C}" Width="90"/>
                <DataGridTextColumn Header="Vence" Binding="{Binding FechaPago, StringFormat=dd/MM/yyyy}" Width="90"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Resumen de monto total -->
        <Border Grid.Row="3"
                Background="#F0F4F8"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                CornerRadius="5"
                Padding="15,10"
                Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Ícono y etiqueta -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="💰" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtCantidadDeudas"
                               FontSize="13" Foreground="Gray"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <!-- Monto total -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Monto total:"
                               FontSize="13" Foreground="Gray"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtMontoTotal"
                               FontSize="16" FontWeight="Bold"
                               Foreground="#E74C3C"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Botones -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">

            <!-- Botón Exportar a Excel -->
            <Button Content="Exportar a Excel"
                    Click="BtnExportarExcel_Click"
                    Height="38" Width="160"
                    FontSize="13"
                    Background="#27AE60"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Margin="0,0,10,0"/>

            <!-- Botón Entendido -->
            <Button Content="Entendido"
                    Click="BtnCerrar_Click"
                    Height="38" Width="150"
                    FontSize="13"
                    Background="#2C3E50"
                    Foreground="White"
                    Margin="0,0,0,0"/>
        </StackPanel>

    </Grid>
</Window>