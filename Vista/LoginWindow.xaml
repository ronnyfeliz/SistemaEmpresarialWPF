<Window x:Class="Project_v1.Vista.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iniciar Sesión" 
        Height="580" 
        Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F6F9">

    <Window.Resources>
        <Style x:Key="InputStyle" TargetType="Control">
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#2C3E50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A252F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#17202A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Return"
                    Command="{Binding LoginCommand}"
                    CommandParameter="{Binding ElementName=TxtContrasena}"/>
    </Window.InputBindings>

    <Border Background="White"
            CornerRadius="12"
            Margin="28"
            BorderBrush="#DADFE3"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#CCCCCC"
                              BlurRadius="20"
                              ShadowDepth="4"
                              Opacity="0.3"
                              Direction="270"/>
        </Border.Effect>

        <Grid Margin="40,32,40,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 0 Ícono -->
                <RowDefinition Height="Auto"/>
                <!-- 1 Título -->
                <RowDefinition Height="Auto"/>
                <!-- 2 Subtítulo -->
                <RowDefinition Height="Auto"/>
                <!-- 3 Label Usuario -->
                <RowDefinition Height="Auto"/>
                <!-- 4 Input Usuario -->
                <RowDefinition Height="Auto"/>
                <!-- 5 Label Contraseña -->
                <RowDefinition Height="Auto"/>
                <!-- 6 Input Contraseña -->
                <RowDefinition Height="Auto"/>
                <!-- 7 Botón Login -->
                <RowDefinition Height="Auto"/>
                <!-- 8 Soporte -->
            </Grid.RowDefinitions>

            <!-- Ícono -->
            <Border Grid.Row="0"
                    Width="62" Height="62"
                    Background="#2C3E50"
                    CornerRadius="31"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,12">
                <TextBlock Text="👤" FontSize="27"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Título -->
            <TextBlock Grid.Row="1"
                       Text="Bienvenido"
                       FontSize="22" FontWeight="Bold"
                       Foreground="#1A2E4A"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4"/>

            <!-- Subtítulo -->
            <TextBlock Grid.Row="2"
                       Text="Ingresa tus credenciales para continuar"
                       FontSize="11.5" Foreground="#7F8C8D"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,22"/>

            <!-- Label Usuario -->
            <TextBlock Grid.Row="3"
                       Text="Usuario"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="#2C3E50"
                       Margin="2,0,0,5"/>

            <!-- Input Usuario -->
            <TextBox Grid.Row="4"
                     x:Name="TxtUsuario"
                     Text="{Binding NombreUsuario, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource InputStyle}"
                     Margin="0,0,0,14"/>

            <!-- Label Contraseña -->
            <TextBlock Grid.Row="5"
                       Text="Contraseña"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="#2C3E50"
                       Margin="2,0,0,5"/>

            <!-- Input Contraseña -->
            <PasswordBox Grid.Row="6"
                         x:Name="TxtContrasena"
                         Style="{StaticResource InputStyle}"
                         Margin="0,0,0,20"/>

            <!-- Botón Iniciar Sesión -->
            <Button Grid.Row="7"
                    Content="Iniciar Sesión"
                    Command="{Binding LoginCommand}"
                    CommandParameter="{Binding ElementName=TxtContrasena}"
                    Style="{StaticResource LoginButtonStyle}"
                    Margin="0,0,0,0"/>

            <!-- Soporte -->
            <StackPanel Grid.Row="8" Margin="0,16,0,0" HorizontalAlignment="Center">
                <Separator Margin="0,0,0,10" Background="#EEEEEE"/>
                <Button Content="¿Olvidaste tus credenciales? Contactar soporte"
                        Command="{Binding ContactarSoporteCommand}"
                        FontSize="11" Foreground="#2980B9"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <TextBlock Text="{TemplateBinding Content}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   TextDecorations="Underline"
                                                   HorizontalAlignment="Center"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="#1F5E8C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

        </Grid>
    </Border>
</Window>