<UserControl x:Class="Project_v1.Vista.HistorialVentasControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== TITULO Y FILTROS ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Historial de Ventas"
                       FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

            <!-- FILA 1: Fechas y factura -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Desde:"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker Grid.Column="1" SelectedDate="{Binding FiltroFechaInicio}" Margin="0,0,15,0"/>
                <TextBlock Grid.Column="2" Text="Hasta:"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker Grid.Column="3" SelectedDate="{Binding FiltroFechaFin}" Margin="0,0,15,0"/>
                <TextBox Grid.Column="4"
                         Text="{Binding FiltroFactura, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6" Margin="0,0,8,0">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush Stretch="None" AlignmentX="Left">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="Buscar por factura..."
                                                               Foreground="Gray" Margin="8,0,0,0"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <Button Grid.Column="5" Content="✖ Limpiar"
                        Command="{Binding LimpiarFiltrosCommand}"
                        Padding="8,0" Height="32"
                        Background="#7F8C8D" Foreground="White"/>
            </Grid>

            <!-- FILA 2: Filtro por usuario -->
            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Usuario/Cajero:"
                           VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="Gray" FontSize="13"/>
                <TextBox Grid.Column="1"
                         Text="{Binding FiltroUsuario, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush Stretch="None" AlignmentX="Left">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="Filtrar por usuario..."
                                                               Foreground="Gray" Margin="8,0,0,0"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Grid>

            <!-- FILA 3: Botones -->
            <Grid Grid.Row="3">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Exportar ZIP -->
                    <Button Content="📦 Exportar Historial como ZIP"
                            Command="{Binding ExportarHistorialZipCommand}"
                            Padding="12,6" Height="34"
                            Background="#8E44AD" Foreground="White"
                            FontSize="12" Margin="0,0,10,0"/>

                    <!-- Generar Reporte con Popup -->
                    <Grid>
                        <Button x:Name="BtnGenerarReporte"
                                Content="📊 Generar Reporte ▾"
                                Padding="12,6" Height="34"
                                Background="#1A6B3A" Foreground="White"
                                FontSize="12"
                                Click="BtnGenerarReporte_Click"/>

                        <Popup x:Name="PopupReporte"
                               PlacementTarget="{Binding ElementName=BtnGenerarReporte}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Border Background="White"
                                    BorderBrush="#CCCCCC"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <!-- FIX XDG0010: DropShadowEffect inline en lugar de DynamicResource -->
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="3"
                                                      Direction="270" Opacity="0.18"
                                                      Color="#000000"/>
                                </Border.Effect>

                                <StackPanel Width="240" Margin="0,4">

                                    <!-- Cabecera -->
                                    <Border Background="#1A6B3A" Padding="12,8"
                                            CornerRadius="3,3,0,0">
                                        <TextBlock Text="Selecciona el período"
                                                   Foreground="White" FontWeight="Bold" FontSize="12"/>
                                    </Border>

                                    <!-- Reporte del Día -->
                                    <Button Content="  📅  Reporte del Día"
                                            Command="{Binding ReporteDiaCommand}"
                                            HorizontalContentAlignment="Left"
                                            Padding="16,8" Margin="4,4,4,1"
                                            Background="Transparent" BorderThickness="0"
                                            FontSize="12" Foreground="#2C3E50"
                                            Click="OpcionReporte_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#E8F5E9"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Reporte del Mes -->
                                    <Button Content="  📅  Reporte del Mes"
                                            Command="{Binding ReporteMesCommand}"
                                            HorizontalContentAlignment="Left"
                                            Padding="16,8" Margin="4,1"
                                            Background="Transparent" BorderThickness="0"
                                            FontSize="12" Foreground="#2C3E50"
                                            Click="OpcionReporte_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#E8F5E9"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Reporte del Año -->
                                    <Button Content="  📅  Reporte del Año"
                                            Command="{Binding ReporteAnioCommand}"
                                            HorizontalContentAlignment="Left"
                                            Padding="16,8" Margin="4,1,4,8"
                                            Background="Transparent" BorderThickness="0"
                                            FontSize="12" Foreground="#2C3E50"
                                            Click="OpcionReporte_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#E8F5E9"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                </StackPanel>
            </Grid>
        </Grid>

        <!-- ===== TABLAS ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- Tabla de ventas -->
            <Grid Grid.Column="0" Margin="0,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Ventas realizadas"
                           FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Ventas}"
                          SelectedItem="{Binding VentaSeleccionada}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column" CanUserResizeRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Factura"  Binding="{Binding NumFactura}" Width="*"/>
                        <DataGridTextColumn Header="Fecha"    Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="90"/>
                        <DataGridTextColumn Header="Hora"     Binding="{Binding Fecha, StringFormat=HH:mm}" Width="60"/>
                        <DataGridTextColumn Header="Usuario"  Binding="{Binding Usuario.Nombre}" Width="100"/>
                        <DataGridTextColumn Header="Total"    Binding="{Binding Total, StringFormat=C}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Panel derecho: detalle -->
            <Grid x:Name="GridDetalles" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Detalle de la venta"
                           FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>

                <Button Grid.Row="1" Content="📄 Exportar a PDF"
                        Command="{Binding DataContext.ExportarPdfCommand,
                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                        HorizontalAlignment="Left" Padding="10,5" Margin="0,0,0,8"
                        Background="#2C3E50" Foreground="White"/>

                <!-- Productos -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#2C3E50"
                            CornerRadius="3,3,0,0" Padding="8,5">
                        <TextBlock Text="🛒  Productos" Foreground="White"
                                   FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding DataContext.Detalles,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserResizeRows="False" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Producto"  Binding="{Binding Producto.Nombre}" Width="*"/>
                            <DataGridTextColumn Header="Cant."     Binding="{Binding Cantidad}" Width="50"/>
                            <DataGridTextColumn Header="Precio"    Binding="{Binding PrecioUnitario, StringFormat=C}" Width="75"/>
                            <DataGridTextColumn Header="Subtotal"  Binding="{Binding Subtotal, StringFormat=C}" Width="75"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Servicios -->
                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#1A5276"
                            CornerRadius="3,3,0,0" Padding="8,5">
                        <TextBlock Text="🛠  Servicios" Foreground="White"
                                   FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding DataContext.DetallesServicio,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserResizeRows="False" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" MaxHeight="150">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Servicio"  Binding="{Binding Servicio.Nombre}" Width="*"/>
                            <DataGridTextColumn Header="Cant."     Binding="{Binding Cantidad}" Width="50"/>
                            <DataGridTextColumn Header="Precio"    Binding="{Binding PrecioUnitario, StringFormat=C}" Width="75"/>
                            <DataGridTextColumn Header="Subtotal"  Binding="{Binding Subtotal, StringFormat=C}" Width="75"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== RESUMEN TOTAL ===== -->
        <Border Grid.Row="2" Background="#F0F4F8" BorderBrush="#CCCCCC"
                BorderThickness="1" CornerRadius="5" Padding="15,10" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Ventas.Count, StringFormat='Total de ventas: {0}'}"
                           FontSize="13" Foreground="Gray" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Total del periodo:" FontSize="13" Foreground="Gray"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding TotalFiltrado, StringFormat=C}"
                               FontSize="16" FontWeight="Bold"
                               Foreground="#27AE60" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
