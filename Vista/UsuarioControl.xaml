<UserControl x:Class="Project_v1.Vista.UsuarioControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" Margin="0,40,0,40">

                <!-- Icono de usuario -->
                <TextBlock Text="👤" FontSize="60"
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- Nombre del usuario -->
                <TextBlock Text="{Binding NombreUsuario}"
                           FontSize="26" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>

                <!-- Rol -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,0,0,8">
                    <TextBlock Text="Rol: " FontSize="15" Foreground="Gray"/>
                    <TextBlock Text="{Binding RolUsuario}"
                               FontSize="15" Foreground="#2980B9" FontWeight="Bold"/>
                </StackPanel>

                <!-- Estado -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,0,0,25">
                    <TextBlock Text="Estado: " FontSize="15" Foreground="Gray"/>
                    <TextBlock Text="{Binding EstadoSesion}"
                               FontSize="15" Foreground="#27AE60" FontWeight="Bold"/>
                </StackPanel>

                <Separator Margin="0,0,0,25"/>

                <!-- ===== SECCION ADMINISTRADOR: GESTION DE CAJEROS ===== -->
                <StackPanel Visibility="{Binding EsAdministrador,
                            Converter={StaticResource BoolToVisibilityConverter}}">

                    <!-- Titulo + contador -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Gestion de Cajeros"
                                   FontSize="16" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding InfoCajeros}"
                                   FontSize="12" Foreground="#7F8C8D"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Tabla de cajeros activos -->
                    <DataGrid ItemsSource="{Binding Cajeros}"
                              SelectedItem="{Binding CajeroSeleccionado}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              CanUserResizeRows="False"
                              MinHeight="80"
                              Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding Id}"
                                                Width="45"/>
                            <DataGridTextColumn Header="Nombre"
                                                Binding="{Binding Nombre}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Boton eliminar cajero seleccionado -->
                    <Button Content="🗑  Eliminar Cajero Seleccionado"
                            Command="{Binding EliminarCajeroCommand}"
                            Padding="10" FontSize="13" Height="38"
                            Background="#E74C3C" Foreground="White"
                            Margin="0,0,0,10"/>

                    <!-- Boton mostrar formulario — oculto si ya se muestra el form o si se llego al limite -->
                    <Button Content="➕  Agregar Cajero"
                            Command="{Binding MostrarFormularioCommand}"
                            Visibility="{Binding PuedeAgregarCajero,
                                Converter={StaticResource BoolToVisibilityConverter}}"
                            Padding="10" FontSize="13" Height="38"
                            Background="#27AE60" Foreground="White"
                            Margin="0,0,0,10"/>

                    <!-- Aviso cuando se alcanza el limite de 5 cajeros -->
                    <TextBlock Text="Limite de 5 cajeros alcanzado."
                               Foreground="#E74C3C" FontSize="13"
                               Margin="0,0,0,10"
                               Visibility="{Binding PuedeAgregarCajero,
                                   Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                    <!-- Formulario agregar cajero -->
                    <StackPanel Visibility="{Binding MostrarFormularioCajero,
                                Converter={StaticResource BoolToVisibilityConverter}}"
                                Margin="0,0,0,10">

                        <TextBlock Text="Nombre de usuario" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding NuevoCajeroNombre, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8" FontSize="13" Margin="0,0,0,10"/>

                        <TextBlock Text="Contrasena" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="PbContrasena"
                                     Padding="8" FontSize="13" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Guardar"
                                    Command="{Binding GuardarCajeroCommand}"
                                    CommandParameter="{Binding ElementName=PbContrasena}"
                                    Padding="10" FontSize="13" Height="38"
                                    Background="#27AE60" Foreground="White"/>

                            <Button Grid.Column="2" Content="Cancelar"
                                    Command="{Binding CancelarFormularioCommand}"
                                    CommandParameter="{Binding ElementName=PbContrasena}"
                                    Padding="10" FontSize="13" Height="38"
                                    Background="#7F8C8D" Foreground="White"/>
                        </Grid>
                    </StackPanel>

                    <Separator Margin="0,15,0,20"/>
                </StackPanel>

                <!-- Boton Cambiar Cuenta -->
                <Button Content="🔄  Cambiar Cuenta"
                        Command="{Binding CambiarCuentaCommand}"
                        Padding="10" FontSize="14" Height="45"
                        Background="#2C3E50" Foreground="White"
                        Margin="0,0,0,10"/>

                <!-- Boton Cerrar Sesion -->
                <Button Content="🚪  Cerrar Sesion"
                        Command="{Binding CerrarSesionCommand}"
                        Padding="10" FontSize="14" Height="45"
                        Background="#E74C3C" Foreground="White"/>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
