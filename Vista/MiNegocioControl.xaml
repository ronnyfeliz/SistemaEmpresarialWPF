<UserControl x:Class="Project_v1.Vista.MiNegocioControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <UserControl.Resources>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- Botones deshabilitados se ven oscuros/opacos -->
        <Style TargetType="Button">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35"/>
                    <Setter Property="Cursor" Value="No"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox deshabilitado se ve opaco -->
        <Style TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Mi negocio" FontSize="20" FontWeight="SemiBold" Foreground="#1A2E4A"/>
                <TextBlock Text="Esta información aparecerá en todas las facturas generadas."
                           FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- Layout dos columnas -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ═══════════ COLUMNA IZQUIERDA ═══════════ -->
                <StackPanel Grid.Column="0"
                            IsEnabled="{Binding EsAdministrador}">

                    <!-- Información del negocio -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="INFORMACIÓN DEL NEGOCIO" Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="Nombre *" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding NombreNegocio, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldBox}" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="RNC" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding NumeroRNC, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FieldBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Teléfono" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FieldBox}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FieldBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Sitio web" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding SitioWeb, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FieldBox}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Dirección" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldBox}" Margin="0,0,0,12"/>

                            <TextBlock Text="Slogan" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Slogan, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FieldBox}"/>
                        </StackPanel>
                    </Border>

                    <!-- Logo -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="LOGO DEL NEGOCIO" Style="{StaticResource SectionTitle}"/>
                            <Border Height="90" Background="#F8F9FA" BorderBrush="#DDDDDD"
                                    BorderThickness="1" CornerRadius="6" Margin="0,0,0,10">
                                <Grid>
                                    <TextBlock Text="Sin logo — formatos admitidos: PNG, JPG"
                                               Foreground="#BBBBBB" FontSize="11"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LogoPreview}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Image Source="{Binding LogoPreview}" Stretch="Uniform" Margin="8">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LogoPreview}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="🖼 Seleccionar logo"
                                        Command="{Binding SeleccionarLogoCommand}"
                                        Padding="10,7" Margin="0,0,8,0"
                                        Background="#3B82F6" Foreground="White"/>
                                <Button Content="🗑 Eliminar logo"
                                        Command="{Binding EliminarLogoCommand}"
                                        Padding="10,7"
                                        Background="#EF4444" Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Botón guardar -->
                    <Button Content="💾 Guardar información"
                            Command="{Binding GuardarCommand}"
                            Height="42" FontSize="14"
                            Background="#1E40AF" Foreground="White"/>

                </StackPanel>

                <!-- ═══════════ COLUMNA DERECHA ═══════════ -->
                <StackPanel Grid.Column="2">

                    <!-- Estado del sistema -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="ESTADO DEL SISTEMA" Style="{StaticResource SectionTitle}"/>
                            <Grid Margin="0,6,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Último backup"
                                           FontSize="12" Foreground="#64748B" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding UltimoBackupTexto}"
                                           FontSize="12" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Carpeta actual"
                                           FontSize="12" Foreground="#64748B" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{Binding RutaBackupsTexto}"
                                           FontSize="11" Foreground="#185FA5"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Política"
                                           FontSize="12" Foreground="#64748B"/>
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="1 backup por día · últimos 30 días"
                                           FontSize="11" Foreground="#64748B"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Respaldo y mantenimiento -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="RESPALDO Y MANTENIMIENTO" Style="{StaticResource SectionTitle}"/>

                            <!-- Botones disponibles para TODOS -->
                            <UniformGrid Columns="2" Margin="0,4,0,6">
                                <Button Content="💾 Backup ahora"
                                        Command="{Binding HacerBackupAhoraCommand}"
                                        Padding="10,8" Margin="0,0,6,6"
                                        Background="#22C55E" Foreground="White"/>
                                <Button Content="📁 Abrir carpeta"
                                        Command="{Binding AbrirCarpetaBackupsCommand}"
                                        Padding="10,8" Margin="0,0,0,6"
                                        Background="#3B82F6" Foreground="White"/>
                                <Button Content="🕘 Ver historial"
                                        Command="{Binding VerHistorialBackupsCommand}"
                                        Padding="10,8" Margin="0,0,6,0"
                                        Background="#64748B" Foreground="White"/>
                            </UniformGrid>

                            <!-- Botones solo para ADMIN — deshabilitados y opacos para cajero -->
                            <UniformGrid Columns="2"
                                         IsEnabled="{Binding EsAdministrador}"
                                         Margin="0,0,0,0">
                                <Button Content="🔀 Cambiar ubicación"
                                        Command="{Binding CambiarUbicacionBackupCommand}"
                                        Padding="10,8" Margin="0,6,6,0"
                                        Background="#8B5CF6" Foreground="White"/>
                                <Button Content="↩ Restablecer ruta"
                                        Command="{Binding RestablecerRutaDefectoCommand}"
                                        Padding="10,8" Margin="0,6,0,0"
                                        Background="#64748B" Foreground="White"/>
                                <Button Content="♻ Restaurar backup"
                                        Command="{Binding RestaurarBackupCommand}"
                                        Padding="10,8" Margin="0,6,6,0"
                                        Background="#EF4444" Foreground="White"/>
                            </UniformGrid>

                        </StackPanel>
                    </Border>

                    <!-- Vista previa de factura -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="VISTA PREVIA DE FACTURA" Style="{StaticResource SectionTitle}"/>
                            <Border Background="#F8F9FA" BorderBrush="#EEEEEE"
                                    BorderThickness="1" CornerRadius="6" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding NombreNegocio}"
                                                   FontSize="15" FontWeight="SemiBold" Foreground="#1A2E4A"/>
                                        <TextBlock Text="{Binding Direccion}"
                                                   FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding Telefono}"
                                                   FontSize="11" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding Email}"
                                                   FontSize="11" Foreground="#64748B"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="52" Height="52"
                                            Background="White" BorderBrush="#DDDDDD"
                                            BorderThickness="1" CornerRadius="6"
                                            Margin="12,0,0,0">
                                        <Image Source="{Binding LogoPreview}" Stretch="Uniform" Margin="4">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LogoPreview}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock Text="— así aparecerá tu negocio en las facturas —"
                                       FontSize="10" Foreground="#BBBBBB"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>