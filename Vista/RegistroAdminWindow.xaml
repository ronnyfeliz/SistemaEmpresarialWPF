<Window x:Class="Project_v1.Vista.RegistroAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registro de Administrador"
        Height="540"
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid Margin="35">

        <Border Background="White"
                CornerRadius="10"
                Padding="25"
                BorderBrush="#DDDDDD"
                BorderThickness="1">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Título -->
                <TextBlock Grid.Row="0"
                           Text="Configuración Inicial"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <!-- Subtítulo -->
                <TextBlock Grid.Row="1"
                           Text="Registra el usuario administrador del sistema"
                           FontSize="13"
                           Foreground="Gray"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <!-- Nombre -->
                <TextBlock Grid.Row="2"
                           Text="Nombre de usuario"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <TextBox Grid.Row="3"
                         x:Name="TxtNombre"
                         Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14"
                         Height="40"
                         Padding="10"
                         Margin="0,0,0,18"/>

                <!-- Contraseña -->
                <TextBlock Grid.Row="4"
                           Text="Contraseña"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <PasswordBox Grid.Row="5"
                             x:Name="TxtContrasena"
                             FontSize="14"
                             Height="40"
                             Padding="10"
                             Margin="0,0,0,18"/>

                <!-- Confirmar contraseña -->
                <TextBlock Grid.Row="6"
                           Text="Confirmar contraseña"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>

                <PasswordBox Grid.Row="7"
                             x:Name="TxtConfirmar"
                             FontSize="14"
                             Height="40"
                             Padding="10"
                             Margin="0,0,0,30"/>

                <!-- Botón -->
                <Button Grid.Row="8"
                        Content="Registrar Administrador"
                        Click="BtnRegistrar_Click"
                        Height="45"
                        MinWidth="260"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Background="#2C3E50"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"/>

            </Grid>

        </Border>

    </Grid>
</Window>